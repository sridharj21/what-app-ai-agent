version: 0.2

env:
  variables:
    AWS_REGION: ap-south-1
    ECR_REPOSITORY: sridhar-repo
    IMAGE_TAG: latest

phases:
  pre_build:
    commands:
      - echo "Logging in to Amazon ECR..."
      - aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin 466749146115.dkr.ecr.ap-south-1.amazonaws.com

  build:
    commands:
      - echo "Building Docker image..."
      - docker build -t sridhar-repo .
      - docker tag sridhar-repo:latest 466749146115.dkr.ecr.ap-south-1.amazonaws.com/sridhar-repo:latest

  post_build:
    commands:
      - echo "Pushing Docker image..."
      - docker push 466749146115.dkr.ecr.ap-south-1.amazonaws.com/sridhar-repo:latest
      - printf '{"ImageURI":"466749146115.dkr.ecr.ap-south-1.amazonaws.com/sridhar-repo:latest"}' > imageDetail.json

artifacts:
  files:
    - imageDetail.json
